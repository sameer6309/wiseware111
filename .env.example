# ==============================================================================
# WISEWARE AI — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local (or .env) and replace the placeholders with your credentials.
# Do NOT commit .env or .env.local to Git version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL (Required for persistent database & Prisma ORM)
# ------------------------------------------------------------------------------
# In Supabase Dashboard:
# -> Go to: Project Settings -> Database -> Connection String
# -> Mode: "Transaction" (pooler port 6543) for DATABASE_URL
# -> Mode: "Session" (pooler port 5432) or direct database port 5432 for DIRECT_URL

# Transaction connection pooler (used by Next.js serverless functions)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string (used by Prisma CLI for migrations & schema push)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional Supabase API keys (if using Supabase Auth or Storage)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 2. AI PROVIDER CONFIGURATION (Optional: real AI inference vs. transparent demo mode)
# ------------------------------------------------------------------------------
# If any of the keys below is provided, Wiseware AI will route inference queries
# to that real model. If none is set, Wiseware AI automatically runs in a transparent,
# clearly-labeled Heuristic Demo Mode with realistic enterprise telemetry.

# OpenAI API Key (e.g. for gpt-4o, gpt-4o-mini)
OPENAI_API_KEY=""

# Groq API Key (e.g. for ultra-fast llama-3.3-70b-versatile)
GROQ_API_KEY=""

# Anthropic API Key (e.g. for claude-3-5-sonnet)
ANTHROPIC_API_KEY=""

# Google Gemini API Key
GEMINI_API_KEY=""

# Active default provider: "demo" | "openai" | "groq" | "anthropic" | "gemini"
AI_PROVIDER_DEFAULT="demo"

# ------------------------------------------------------------------------------
# 3. EXPLORIUM AGENTSOURCE B2B ENRICHMENT
# ------------------------------------------------------------------------------
# API Key for Explorium AgentSource v2 (https://admin.explorium.ai)
# Used server-side only for business matching and firmographic/technographic enrichment.
# Never expose this key to client-side bundles.
EXPLORIUM_API_KEY=""

# ------------------------------------------------------------------------------
# 4. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
